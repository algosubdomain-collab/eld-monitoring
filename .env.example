# Bu faylni ".env" nomi bilan nusxalang va to'ldiring.
# .env fayli .gitignore da — hech qayerga yuklanmaydi.

# Qaysi manba ishlatilsin: sample (test) yoki leadereld (haqiqiy)
ELD_SOURCE=drivehos

# Namuna manbada nechta haydovchi yaratilsin (faqat ELD_SOURCE=sample uchun)
ELD_SAMPLE_SIZE=100

# Token bu yerga YOZILMAYDI. Saytga birinchi kirganda brauzer o'zi so'raydi
# va faqat o'sha brauzerda saqlaydi. Har bir qurilma o'z tokenini kiritadi.
#
# Quyidagilar ixtiyoriy — agar bitta umumiy token bilan ishlatmoqchi bo'lsangiz:
ELD_ACCESS_TOKEN=
ELD_REFRESH_TOKEN=

# Kerak bo'lsa o'zgartiriladi
ELD_BASE_URL=https://api.drivehos.app/api
ELD_TENANT_ID=d0e24f31-1242-416c-a6d6-57a30bdff44d
ELD_REFRESH_SECONDS=60
# 0.0.0.0 — tarmoqdagi boshqa qurilmalar ham kira oladi
HOST=0.0.0.0
PORT=3000

# Standart akkaunt (faqat hali hech qanday akkaunt bo'lmaganda yaratiladi).
# Birinchi kirishda parolni almashtirish majburiy.
DEFAULT_ADMIN_LOGIN=admin
DEFAULT_ADMIN_PASSWORD=admin12345

# Uzilish xabarlari
# Haydovchi shuncha daqiqa uzluksiz offline tursagina xabar ketadi
DISCONNECT_CONFIRM_MINUTES=5
# Dam oluvchilar ro'yxati shuncha soatda bir qayta tuziladi
RESTING_CHECK_HOURS=12
# Shuncha soat bitta statusda (Sleeper yoki Off duty) turgan haydovchi dam oluvchi hisoblanadi
RESTING_MIN_HOURS=24

# ---------------------------------------------------------------- DOT tarozilari
# Haydovchining yo'lida weigh station / truck scale bo'lsa, jadvaldagi DOT
# ustunida qizil nuqta yonadi. O'tib ketgandan keyin o'chadi.

# Shuncha kilometr ichidagi tarozi ogohlantiradi
DOT_ALERT_KM=5

# Tarozilar joylashuvi OpenStreetMap'dan olinadi — bepul, kalit kerak emas.
# Hudud 0.5 darajali kataklarga bo'linib, har biri BIR MARTA yuklanadi va
# data/scales.json ga keshlanadi. Keyin masofa hisobi lokal ketadi.
# Kesh shuncha kundan keyin yangilanadi:
SCALES_TTL_DAYS=30
# Bitta yangilanishda nechta yangi katak yuklansin (bepul xizmatni bosmaslik uchun)
SCALES_CELLS_PER_PASS=4
# O'z Overpass serveringiz bo'lsa (ommaviylari tez-tez band bo'ladi):
OVERPASS_URL=

# IXTIYORIY: Google Places bilan to'ldirish. Bo'sh qoldirsangiz ham hammasi
# ishlayveradi — OSM asosiy manba. Kalit qo'yilsa, katak yuklanayotganda
# Google natijalari ham qo'shiladi (har bir katak uchun bitta so'rov).
GOOGLE_MAPS_API_KEY=
