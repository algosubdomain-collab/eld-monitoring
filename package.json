{
  "name": "eld-monitoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ELD ma'lumotlarini yig'ib, web dashboard'da ko'rsatuvchi monitoring tizimi",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && node --env-file-if-exists=.env src/server.js",
    "serve": "node --env-file-if-exists=.env src/server.js",
    "probe": "node --env-file-if-exists=.env src/probe.js",
    "user:reset": "node --env-file-if-exists=.env scripts/reset-password.mjs",
    "dot:check": "node --env-file-if-exists=.env scripts/dot-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "playwright-core": "^1.63.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "vite": "^7.3.6"
  }
}
